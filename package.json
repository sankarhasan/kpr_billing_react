{
  "name": "kpr-billing",
  "version": "0.1.0",
  "description": "KPR Firecrackers Billing Software - offline Windows desktop billing application",
  "private": true,
  "author": "KPR",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:test",
    "test": "node --test tests/products.test.ts tests/customers.test.ts tests/invoices.test.ts tests/history.test.ts tests/print.test.ts tests/shopsettings.test.ts tests/paymentmethod.test.ts tests/csv.test.ts tests/csv-import-pipeline.test.ts tests/migration.test.ts tests/repo.test.ts tests/real-csv.test.ts",
    "smoke:db": "electron scripts/smoke-electron.cjs",
    "verify": "electron .",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "electron@44.9.0": true,
    "esbuild@0.28.2": true,
    "electron-winstaller@5.4.0": true
  }
}
